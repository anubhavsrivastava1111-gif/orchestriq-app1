  <groupId>com.orchestriq.lifeline</groupId>
  <artifactId>native-tests</artifactId>
  <version>1</version>
  <dependencies>
    <dependency><groupId>org.robolectric</groupId><artifactId>robolectric</artifactId><version>4.17</version>
      <exclusions>
