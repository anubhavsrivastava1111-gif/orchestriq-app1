{
  "name": "orchestriq-desktop",
  "productName": "OrchestrIQ",
  "version": "1.0.0",
  "private": true,
  "description": "OrchestrIQ desktop app for Windows, macOS and Linux",
  "author": "GorakhAI",
  "homepage": "https://orchestriq.gorakhai.com",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.gorakhai.orchestriq",
    "productName": "OrchestrIQ",
    "copyright": "Copyright \u00a9 GorakhAI",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "offline.html",
      "build/icon.png"
    ],
    "artifactName": "OrchestrIQ-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "OrchestrIQ-${version}-windows-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OrchestrIQ"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "OrchestrIQ uses the microphone for voice input."
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    }
  }
}
